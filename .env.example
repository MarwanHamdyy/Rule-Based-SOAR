# ============================================================
# SOAR Engine - Environment Variables Example
# Copy this file to .env and fill in your values
# ============================================================

# --- Elasticsearch Connection ---
ES_HOST=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
# Optional: use API key instead of username/password
# ES_API_KEY=your_base64_api_key_here
# Set to false to skip TLS certificate verification (dev only)
ES_VERIFY_CERTS=false

# --- Source & Target Indices ---
# Suricata alert source index pattern (Filebeat default)
ES_SOURCE_INDEX=filebeat-*
# SOAR action output index prefix (date appended automatically)
ES_TARGET_INDEX_PREFIX=soar-actions

# --- Engine Behaviour ---
# Polling interval in seconds (how often to query ES for new events)
POLL_INTERVAL_SECONDS=10
# Engine mode: "live" or "replay"
ENGINE_MODE=live
# Path to checkpoint file (tracks last processed event timestamp)
CHECKPOINT_FILE=./data/checkpoint.json
# Replay mode: fetch events from this ISO-8601 timestamp
REPLAY_FROM=2024-01-01T00:00:00Z

# --- VirusTotal Enrichment (optional) ---
VT_ENABLED=false
VT_API_KEY=your_virustotal_api_key_here
# Cache TTL in seconds (default: 1 hour)
VT_CACHE_TTL=3600

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/soar.log
